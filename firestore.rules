rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles: users can only write their own doc; any auth user can read
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Videos: any authenticated user can read; writes allowed for authenticated users
    // TODO: restrict writes to admin custom claim when Firebase custom claims are implemented
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Assignments: users can only read THEIR OWN assignments
    // All writes go through the backend API (Admin SDK bypasses rules)
    match /asignaciones/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.usuarioId;
      allow write: if false;
    }
  }
}
